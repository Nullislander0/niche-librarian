#!/usr/bin/env python3
"""Git pre-push hook: refuse to push reports, results, data or private packs.

Install once per clone:   cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

Blocks a push if any file it adds or changes is a crawl database, cache or data file, a
report (anything under reports/ or data/, digests, memos), a secret, or a pack that also
exists in your private packs folder (~/.config/niche-librarian/packs by default).
"""
import os
import re
import subprocess
import sys
from pathlib import Path

FORBIDDEN = re.compile(r"(^|/)(data|reports|secrets)/|digest|(^|/)memo/|\.db$|\.bundle$|pseudonym|\.key$|(^|/)\.env",
                       re.I)
ZERO = "0" * 40


def private_packs() -> set[str]:
    dirs = os.environ.get("LIBRARIAN_PACKS", "").split(os.pathsep) if os.environ.get("LIBRARIAN_PACKS") else \
        [str(Path.home() / ".config" / "niche-librarian" / "packs")]
    repo_packs = (Path(__file__).resolve().parents[2] / "packs").resolve()
    out = set()
    for d in map(Path, filter(None, dirs)):
        if d.is_dir() and d.resolve() != repo_packs:
            out |= {p.name for p in d.iterdir() if (p / "sources.yaml").exists()}
    return out


def changed(local: str, remote: str) -> list[str]:
    rng = local if remote == ZERO else f"{remote}..{local}"
    out = subprocess.run(["git", "log", "--name-only", "--diff-filter=ACMR", "--format=", rng],
                         capture_output=True, text=True, check=True).stdout
    return sorted({line for line in out.splitlines() if line})


def main() -> int:
    private = private_packs()
    bad = []
    for line in sys.stdin:
        local_ref, local_sha, remote_ref, remote_sha = line.split()
        if local_sha == ZERO:
            continue
        for path in changed(local_sha, remote_sha):
            parts = path.split("/")
            if FORBIDDEN.search(path) or (parts[0] == "packs" and len(parts) > 1 and parts[1] in private):
                bad.append(path)
    if bad:
        print("pre-push: refusing to push private or result files:", file=sys.stderr)
        for p in bad[:30]:
            print(f"  {p}", file=sys.stderr)
        print("Keep reports in data/reports/ and private packs in ~/.config/niche-librarian/packs/.",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
